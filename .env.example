# ============================================
# Chat Platform — Variaveis de Ambiente
# ============================================
# Copie para .env e preencha os valores.
# NUNCA commite o .env — apenas o .env.example.
#
# Este arquivo serve para DOIS cenarios:
#
#   LOCAL (Docker Compose):
#     - Os valores abaixo sao usados pelo docker-compose.yml
#     - Hostnames sao nomes de containers (ex: postgres-auth, kafka)
#     - Copie, preencha e rode: docker compose up -d --build
#
#   PRODUCAO (GCP):
#     - Os valores vao no Secret Manager do GCP
#     - Veja docs/deploy/gcp-setup-guide.md para o passo a passo
# ============================================

# ---- Postgres (infra) ----
POSTGRES_USER=admin
POSTGRES_PASSWORD=password

# ---- Auth Service ----
AUTH_DATASOURCE_URL=jdbc:postgresql://postgres-auth:5432/auth_db
AUTH_DATASOURCE_USERNAME=admin
AUTH_DATASOURCE_PASSWORD=password
AUTH_MASTER_KEY=dev-master-key-change-in-production
AUTH_PORT=8080

# ---- Chat Service ----
CHAT_DATASOURCE_URL=jdbc:postgresql://postgres-chat:5432/postgres
CHAT_DATASOURCE_USERNAME=admin
CHAT_DATASOURCE_PASSWORD=password
CHAT_KAFKA_BOOTSTRAP_SERVERS=kafka:29092
CHAT_REDIS_URL=redis://redis:6379
CHAT_PORT=8081
CHAT_JWKS_URI=http://auth-service:8080/.well-known/jwks.json

# ---- RSA Key (apenas producao) ----
# Gerar: openssl genrsa 2048 | openssl pkcs8 -topk8 -nocrypt -outform DER | base64 -w0
# RSA_PRIVATE_KEY_BASE64=

# ---- Kafka SASL (apenas producao — Confluent Cloud) ----
# SPRING_KAFKA_PROPERTIES_SASL_JAAS_CONFIG=

# ---- Grafana Cloud (apenas producao) ----
# GRAFANA_REMOTE_WRITE_URL=
# GRAFANA_API_KEY=
